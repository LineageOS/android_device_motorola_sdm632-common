soong_namespace {
        imports: ["hardware/lineage/interfaces/power-libperfmgr",
            "hardware/qcom-caf/common/libqti-perfd-client"
            ],
}

install_symlink {
    name: "dsp_symlink",
    vendor: true,
    installed_location: "lib/dsp",
    symlink_target: "/vendor/dsp",
}
