cc_library_shared {
    name: "liblocation_api",
    vendor: true,
    shared_libs: [
        "libutils",
        "libcutils",
        "libgps.utils",
        "libdl",
        "liblog",
    ],
    srcs: [
        "LocationAPI.cpp",
        "LocationAPIClientBase.cpp",
    ],
    cflags: GNSS_CFLAGS + [
        "-fno-short-enums",
    ],
    header_libs: [
        "libloc_pla_headers",
        "libgps.utils_headers",
    ],
}

cc_library_headers {
    name: "liblocation_api_headers",
    export_include_dirs: ["."],
    vendor: true,
}
